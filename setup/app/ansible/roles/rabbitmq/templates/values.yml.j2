auth:
  username: "{{ rabbitmq_user }}"
  password: "{{ rabbitmq_password }}"
  erlangCookie: "{{ rabbitmq_erlang_cookie }}"

replicaCount: 1

architecture: standalone

persistence:
  enabled: true
  size: "{{ rabbitmq_storage_size }}"

resources:
  requests:
    memory: 256Mi
    cpu: 100m
  limits:
    memory: 512Mi
    cpu: 500m

service:
  type: ClusterIP
  ports:
    amqp: 5672
    manager: 15672

metrics:
  enabled: false

global:
  security:
    allowInsecureImages: true
    
image:
  registry: docker.io
  repository: bitnamilegacy/rabbitmq
  tag: 4.1.3-debian-12-r1

volumePermissions:
  enabled: false

extraPlugins: "rabbitmq_auth_backend_oauth2"

configuration: |-
  management.oauth_enabled = true
  management.oauth_disable_basic_auth = false
  management.oauth_client_id = rabbitmq
  management.oauth_provider_url = {{ keycloak_public_url }}/realms/{{ keycloak_realm }}
  management.oauth_scopes = openid profile email

  management.oauth_resource_servers.1.id = rabbitmq
  management.oauth_resource_servers.1.label = RabbitMQ
  management.oauth_resource_servers.1.oauth_provider_url = {{ keycloak_public_url }}/realms/{{ keycloak_realm }}

  auth_backends.1 = oauth2
  auth_backends.2 = internal

  auth_oauth2.resource_server_id = rabbitmq
  auth_oauth2.issuer = {{ keycloak_public_url }}/realms/{{ keycloak_realm }}
  auth_oauth2.jwks_uri = {{ keycloak_public_url }}/realms/{{ keycloak_realm }}/protocol/openid-connect/certs

  auth_oauth2.https.cacertfile = /tmp/certs/keycloak-caddy-ca.crt
  auth_oauth2.https.peer_verification = verify_peer
  auth_oauth2.https.depth = 5

  auth_oauth2.additional_scopes_key = resource_access.rabbitmq.roles

  auth_oauth2.scope_aliases.administrator = rabbitmq.tag:administrator rabbitmq.read:*/* rabbitmq.write:*/* rabbitmq.configure:*/*
  auth_oauth2.scope_aliases.management = rabbitmq.tag:management rabbitmq.read:*/*
  
hostAliases:
  - ip: "192.168.178.59"
    hostnames:
      - "keycloak.local"

extraVolumes:
  - name: keycloak-caddy-ca
    secret:
      secretName: keycloak-caddy-ca

extraVolumeMounts:
  - name: keycloak-caddy-ca
    mountPath: /tmp/certs/keycloak-caddy-ca.crt
    subPath: caddy-root.crt
    readOnly: true

lifecycleHooks:
  postStart:
    exec:
      command:
        - /bin/sh
        - -c
        - update-ca-certificates || true